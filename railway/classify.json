{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "python jobs/classify.py --all",
    "cronSchedule": "0 7 * * 1",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
