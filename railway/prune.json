{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "python jobs/prune.py",
    "cronSchedule": "0 5 * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
